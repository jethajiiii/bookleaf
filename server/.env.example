# Server Environment Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/bookleaf_portal

# Authentication
JWT_SECRET=change_this_to_a_secure_jwt_secret_min_8_chars
JWT_EXPIRES_IN=7d

# AI Provider Configuration (Optional during scaffold)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
CLAUDE_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
